# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# n8n production webhook URLs (open each webhook node in n8n and copy the Production URL)
N8N_ANALYZE_WEBHOOK_URL=https://your-n8n.onrender.com/webhook/analyze-job
N8N_RESUME_WEBHOOK_URL=https://your-n8n.onrender.com/webhook/process-resume

# Same value you saved in the n8n Header Auth credential (name: x-webhook-secret)
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string

# How many job analyses each user can run per day (protects your Gemini quota)
DAILY_ANALYSIS_LIMIT=20
